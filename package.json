{
  "name": "discord-supporter-ai",
  "version": "1.0.0",
  "description": "Discord Bot with automatic role assignment, recruitment message detection, and voting features",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:activity": "vite build --config vite.activity.config.js",
    "dev:activity": "vite --config vite.activity.config.js"
  },
  "keywords": [
    "discord",
    "bot",
    "openai",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@discord/embedded-app-sdk": "^2.5.0",
    "@holiday-jp/holiday_jp": "^2.5.1",
    "better-sqlite3": "^12.10.0",
    "csv-parse": "^5.5.3",
    "csv-stringify": "^5.1.2",
    "discord.js": "^14.14.1",
    "express": "^4.18.2",
    "openai": "^4.24.1"
  },
  "devDependencies": {
    "happy-dom": "^20.14.0",
    "supertest": "^7.2.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.1"
  }
}
